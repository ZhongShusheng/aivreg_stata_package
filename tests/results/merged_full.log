. * ---------------------------------------------------------------- helpers
. capture program drop record

. program define record
  1.     * record <testname> <rc> : append one CSV row from current e() results
.     args tname rc
  2.     local N = cond(e(N) < ., string(e(N), "%18.0g"), ".")
  3.     local b = "."
  4.     local se = "."
  5.     capture local b = string(el(e(b),1,1), "%21.0g")
  6.     if "`b'" == "." & e(beta) < . local b = string(e(beta), "%21.0g")
  7.     capture local se = string(sqrt(el(e(V),1,1)), "%21.0g")
  8.     if "`se'" == "." {
  9.         foreach s in SE_asymp SE_AR SE_boot SE_gmm SE_2sls {
 10.             if "`se'" == "." & e(`s') < . local se = string(e(`s'), "%21.0
> g")
 11.         }
 12.     }
 13.     local pF   = cond(e(Partial_F) < ., string(e(Partial_F), "%21.0g"), ".
> ")
 14.     local Jval = cond(e(Jval)  < ., string(e(Jval),  "%21.0g"), ".")
 15.     local Jp   = cond(e(pval_J)< ., string(e(pval_J),"%21.0g"), ".")
 16.     local Jdf  = cond(e(J_df)  < ., string(e(J_df),  "%18.0g"), ".")
 17.     local esN  = "."
 18.     capture {
 19.         qui count if e(sample)
 20.         local esN = r(N)
 21.     }
 22.     file open __R using "tests/results/${TESTVER}_results.csv", write appe
> nd
 23.     file write __R "`tname',`rc',`N',`b',`se',`pF',`Jval',`Jdf',`Jp',`esN'
> " _n
 24.     file close __R
 25. end

. 
. global TESTVER "`ver'"

. capture erase "tests/results/`ver'_results.csv"

. file open __R using "tests/results/`ver'_results.csv", write replace
(file tests/results/merged_results.csv not found)

. file write __R "test,rc,N,b,se,Partial_F,Jval,J_df,pval_J,esample_N" _n

. file close __R

. 
